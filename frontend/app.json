{
  "expo": {
    "name": "CrediFácil",
    "slug": "credifacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "credifacil",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.credifacil.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Captura fotos de tu INE para verificar tu identidad",
        "NSPhotoLibraryUsageDescription": "Selecciona fotos de tu identificación",
        "NSFaceIDUsageDescription": "Usa Face ID para iniciar sesión de forma segura"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.credifacil.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1B5E20"
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Captura fotos de tu INE para verificar tu identidad"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para iniciar sesión de forma segura",
          "biometricsSecurityLevel": "strong"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "credifacil-app-2024"
      }
    },
    "owner": "credifacil",
    "description": "CrediFácil - Créditos al alcance de todos. Solicita tu préstamo de forma fácil y sin complicaciones."
  }
}
